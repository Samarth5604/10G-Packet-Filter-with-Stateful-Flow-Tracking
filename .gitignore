# ---------------------------------------------------------------- OCaml / dune

# dune's build tree. Everything in here is reproducible from source.
_build/

# LOCAL OPAM SWITCH. `opam switch create .` puts the entire OCaml compiler and
# every dependency here -- roughly 32,000 files and 390 MB. It is a tool
# installation that happens to live in the project directory, not project
# content. Committing it once cost a 393 MB repository and a history rewrite.
_opam/

*.install
*.merlin
.merlin

# packet_filter.opam is generated by dune from the package stanza in
# dune-project, but IS COMMITTED and must not be ignored:
# `opam install . --deps-only` reads it before dune has ever run, so CI on a
# clean checkout fails without it.

# ------------------------------------------------------------------- Python

.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ------------------------------------------------------------------- Vivado

*.jou
*.log
*.str
.Xil/
vivado*/
usage_statistics_webtalk*
*.backup.jou
*.backup.log

# reports/ IS COMMITTED: ADR 0006 makes a post-route timing report one of the
# five completion conditions, so it is evidence, not build output.
# rtl/*.v IS COMMITTED: generated, but synthesis and any clone must work
# without an opam switch. CI regenerates and diffs against the committed copy.

# ------------------------------------------------------------------ Simulation

sim/vectors.txt
sim_build/
obj_dir/
*.vcd
*.fst
*.ghw
results.xml

# --------------------------------------------------------------------- Formal

formal/*/
!formal/README.md

# ----------------------------------------------------------------- Generated,
# regenerated by make and diffed in CI; the temporary copies are not tracked.
docs/protocol.md.new

# ----------------------------------------------------------------------- Junk

*~
*.swp
.DS_Store